#!/bin/bash
# Release consistency check: every version a user can observe must agree, and
# the shipped engine must be executable on this machine's CPU. Runs offline;
# CI and .githooks/pre-push call it before anything is published.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

python3 - <<'PY'
import json
import os
import platform
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import tomllib

root = os.getcwd()
problems: list[str] = []

def fail(message: str) -> None:
    problems.append(message)

manifest_path = os.path.join(root, "manifest.json")
try:
    with open(manifest_path, encoding="utf-8") as f:
        manifest = json.load(f)
except Exception as exc:  # noqa: BLE001 - report every parse failure alike
    print(f"check-release: manifest.json is not valid JSON: {exc}", file=sys.stderr)
    sys.exit(1)

version = str(manifest.get("version", ""))
if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?", version):
    fail(f"manifest.json version [{version}] is not semver")
if manifest.get("id") != "io.github.tahadx.reel":
    fail("manifest.json id must be io.github.tahadx.reel")
if manifest.get("schemaVersion") != 1:
    fail("manifest.json schemaVersion must be 1")
entry_points = manifest.get("entryPoints") or {}
if not entry_points.get("barWidget") or not entry_points.get("service"):
    fail("manifest.json entryPoints must declare barWidget and service")
for name, rel in entry_points.items():
    if not os.path.isfile(os.path.join(root, rel)):
        fail(f"manifest entry point {name} -> {rel} is missing")

crate_path = os.path.join(root, "crates/reel/Cargo.toml")
try:
    with open(crate_path, "rb") as f:
        crate = tomllib.load(f)
except Exception as exc:  # noqa: BLE001
    print(f"check-release: cannot parse {crate_path}: {exc}", file=sys.stderr)
    sys.exit(1)
crate_version = str(crate.get("package", {}).get("version", ""))
if crate_version != version:
    fail(f"crate version [{crate_version}] != manifest version [{version}]")

machine = platform.machine()
alias = {"amd64": "x86_64", "arm64": "aarch64", "armv7l": "arm"}
machine = alias.get(machine, machine)
elf_machine = {0x03: "i386", 0x28: "arm", 0x3E: "x86_64", 0xB7: "aarch64"}

engine = os.path.join(root, "bin/dist/reel-native")
if not os.path.isfile(engine):
    fail(f"missing shipped engine {engine}")
elif not os.access(engine, os.X_OK):
    fail(f"shipped engine {engine} is not executable")
else:
    with open(engine, "rb") as f:
        header = f.read(20)
    if header[:4] != b"\x7fELF":
        fail(f"shipped engine {engine} is not an ELF")
    elif header[4] != 2 or header[5] != 1:
        fail(f"shipped engine {engine} is not 64-bit little-endian")
    else:
        arch = elf_machine.get(struct.unpack_from("<H", header, 18)[0], "unknown")
        if arch != machine:
            fail(f"shipped engine {engine} targets {arch}, this machine is {machine}")

if not problems and version:
    # `--version` runs the same startup path a real user gets, so give it a
    # throwaway HOME: the check must not touch the caller's machine.
    tmp = tempfile.mkdtemp(prefix="reel-check-release.")
    env = dict(os.environ)
    env.update(
        {
            "HOME": tmp,
            "XDG_CONFIG_HOME": os.path.join(tmp, ".config"),
            "XDG_STATE_HOME": os.path.join(tmp, ".state"),
            "XDG_RUNTIME_DIR": os.path.join(tmp, ".run"),
        }
    )
    try:
        out = subprocess.run(
            [engine, "--version"],
            env=env,
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
        got = out.stdout.strip()
        want = f"reel {version}"
        if out.returncode != 0 or got != want:
            fail(
                f"bin/dist/reel-native reports [{got}] (exit {out.returncode}), "
                f"expected [{want}]"
            )
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

if problems:
    for problem in problems:
        print(f"check-release: {problem}", file=sys.stderr)
    sys.exit(1)
print(f"check-release: ok ({version}, {machine})")
PY
