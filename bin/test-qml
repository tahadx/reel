#!/bin/bash
# Geometry/unit tests for the pure JavaScript helpers behind the preview.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

runner=""
if [ -x /usr/lib/qt6/bin/qmltestrunner ]; then
  runner=/usr/lib/qt6/bin/qmltestrunner
else
  runner="$(command -v qmltestrunner || true)"
fi
if [ -z "$runner" ]; then
  echo "qmltestrunner not available; skipping QML tests"
  exit 0
fi

# Tests must never touch the live desktop. Without this, qmltestrunner inherits
# the session's QT_QPA_PLATFORM (often "wayland;xcb") and opens a visible window
# for every test file. Force the offscreen platform, and silence any engine
# notice a future test might reach.
export QT_QPA_PLATFORM=offscreen
export QT_QUICK_BACKEND=software
export REEL_NO_NOTIFY=1
"$runner" -input tests -txt
