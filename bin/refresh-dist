#!/bin/bash
# Rebuild the shipped engine from this tree and refresh bin/dist.
# Run before committing any crates/ change: the plugin ships the binary, so a
# stale dist records with an old engine no matter what the sources say.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

TARGET=x86_64-unknown-linux-musl
ROOT="$(pwd -P)"
SYSROOT="$(rustc --print sysroot)"
LINKER="$SYSROOT/lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-lld"

# Pin the linker and normalize every path that rustc can embed. With rust-lld,
# one codegen unit, LTO, and no host strip step, the same sources produce the
# same bytes on Arch, Ubuntu, and CI.
remaps=("--remap-path-prefix=${ROOT}=/build/reel")
remaps+=("--remap-path-prefix=${HOME}=/build/home")
if [[ -n "${CARGO_HOME:-}" && "${CARGO_HOME}" != "${HOME}"/* ]]; then
  remaps+=("--remap-path-prefix=${CARGO_HOME}=/build/cargo")
fi
export RUSTFLAGS="${RUSTFLAGS:-} ${remaps[*]} -C linker=${LINKER} -C link-arg=--build-id=none"

# Build for musl: a static engine does not depend on the build machine's
# glibc. Cargo's release profile already strips symbols, so no host strip tool
# is involved in the shipped bytes.
cargo build --release -p reel --target "$TARGET"
mkdir -p bin/dist
cp -f "target/$TARGET/release/reel" bin/dist/reel-native
bin/dist/reel-native --version
