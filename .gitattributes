# Reel targets Linux only. Keep every text file LF in the repository and on
# checkout so shell, Rust, QML, and JSON files cannot drift to CRLF.
* text=auto eol=lf

# The shipped x86_64 engine is the release artifact: keep it byte-exact, out of
# diffs and merges, and marked generated in review. bin/check-release and the
# pre-push gate hash this file.
bin/dist/** binary linguist-generated

# Images are binary payloads.
*.png binary

# Generated or prose-only files: keep them out of language statistics and let
# generated-file handling collapse them in review.
Cargo.lock linguist-generated
.github/** linguist-vendored

# Tests are development-only: keep them out of the published release tarball
# (git archive / GitHub release assets) and out of language statistics. They
# remain in the working tree and in CI.
tests/ export-ignore
crates/reel/tests/ export-ignore
tests/** linguist-detectable=false
