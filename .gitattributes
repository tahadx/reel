# Reel targets Linux only. Keep every text file LF in the repository and on
# checkout so shell, Rust, QML, and JSON files cannot drift to CRLF.
* text=auto eol=lf

# The shipped x86_64 engine is a build artifact: keep it byte-exact, out of
# diffs and merges, and marked generated in review. The pre-push gate hashes
# this file.
bin/dist/** binary linguist-generated

# Images are binary payloads.
*.png binary

# Generated or prose-only files: keep them out of language statistics and let
# generated-file handling collapse them in review.
Cargo.lock linguist-generated
.github/** linguist-vendored

# Third-party notices are vendored verbatim for redistribution. Their bulk (the
# Rust COPYRIGHT-library.html alone is 1.5 MB) must not make GitHub label the
# project HTML.
licenses/** linguist-vendored

# Tests are development-only: keep them out of language statistics. They remain
# in the working tree and in CI.
tests/** linguist-detectable=false
