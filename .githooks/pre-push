#!/bin/bash
# Local pre-push gate: the same checks CI runs. Activate once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
echo "pre-push: fmt, clippy, tests, qml, installer, release, dist"
cargo fmt --check -p reel
cargo clippy -p reel --all-targets -- -D warnings
cargo test --workspace --quiet
bin/lint-qml
bin/test-qml
bash tests/install.test.sh
bin/check-release
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate .
fi
echo "pre-push: dist freshness"
# The plugin ships the engine, so a stale bin/dist records with old code no
# matter what crates/ says. Local toolchains can produce different bytes than
# CI, so the local hook checks the source fingerprint. CI rebuilds the
# committed binary and compares exact bytes on its pinned runner.
before=$(cat bin/dist/reel-native.fingerprint 2>/dev/null || echo missing)
after=$(bin/refresh-dist --print-fingerprint)
if [[ "$before" != "$after" ]]; then
  echo "pre-push: bin/dist is stale for these sources." >&2
  echo "pre-push: run bin/refresh-dist (or use the CI reel-dist artifact) and commit bin/dist." >&2
  exit 1
fi
echo "pre-push: all green"
